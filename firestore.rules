rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Players read AND write their own profile directly from the browser —
    // that's how the life simulator (payday, cars, mortgages, life choice,
    // etc.) saves without every player needing a real Firebase account.
    // This means write access on this collection is intentionally open,
    // not just read access. See README "Security notes" for what that
    // does and doesn't protect against.
    match /players/{playerId} {
      allow read: if true;
      allow write: if true;
    }

    // Rumors and admin config are only ever written by admin.html, which
    // requires a real signed-in Firebase Authentication account.
    match /rumors/{rumorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Player-run clubs (book club, basketball, etc.) — any logged-in player
    // can found or join one directly from the browser, same open-write
    // tradeoff as the players collection above.
    match /clubs/{clubId} {
      allow read: if true;
      allow write: if true;
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
