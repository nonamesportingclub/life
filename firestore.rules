rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can READ player data (needed for a static site with no server —
    // the transfer market, contract list, and leaderboards are public pages).
    // Only a signed-in admin (Firebase Authentication) can WRITE.
    match /players/{playerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /rumors/{rumorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
